{
  "name": "ibl-projects-mcp",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "description": "Installable MCP stdio client for the authenticated MadDots Kanban service",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "bin": {
    "ibl-projects-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/install.md",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "pack:check": "npm run build && node scripts/check-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "sigstore": "5.0.0",
    "tar": "7.5.22",
    "make-fetch-happen": "16.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "@types/make-fetch-happen": "10.0.4"
  },
  "maddotsMcp": {
    "supervisorVersion": 1,
    "workerProtocol": 1
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergiuliano/ibl-projects-mcp.git"
  }
}
