{
  "name": "ibl-projects-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Installable MCP stdio client for the authenticated IBL Projects Kanban service",
  "type": "module",
  "engines": {
    "node": ">=22.22.1 <25"
  },
  "bin": {
    "ibl-projects-mcp": "dist/cli.js"
  },
  "files": [
